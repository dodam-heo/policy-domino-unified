──┼─────────────┼───────────┨ │ │┃ │기 투자액(A) │ │- ┃ │ │┃ ├────────┼─────────────┼───────────┨ │ │┃ │향후 투자계획(B)│ │ ┃ │ │┠──┼────────┼─────────────┼───────────┨ │ │┃부지│사업 총규모(A+B)│ │- ┃ │ │┃ ├────────┼─────────────┼───────────┨ │ │┃ │기 투자액(A) │ │- ┃ │ │┃ ├────────┼─────────────┼───────────┨ │ │┃ │향후 투자계획(B)│ │ ┃ │ │┗━━┷━━━━━━━━┷━━━━━━━━━━━━━┷━━━━━━━━━━━┛ │ │ 6. 투자계획에 따른 자금소요 산출내역 │ │ 7. 자금 조달 계획(이차보전 연계 대출금 외 자금조달 방안) │ │ 8. 협력사와 공동 사업추진 계획(해당시) │ │ 9. 기 타 │ └───────────────────────────────────────────────────────────┘ ※작성요령 ① 지원대상 유형(친환경차 부품 생산기업 및 생산계획 기업, 친환경차 관련 사업재편 승인기업)에 따른 증빙서류(납품계약서 또는 납품확인서, 구매의향서, 사업재편 신청서 및 승인서 등)를 첨부한다. ② 자동차 분야 매출액은 생산제품 유형별 직전년도 매출액을 별첨 양식에 추가 작성한다. ③ 사업개요란에는 현재 사업현황 및 향후 친환경차 관련 사업계획을 기재한다. ④ 설치방안 및 일정란에는 설비 등 설치 시작시기 및 완료시기를 포함한 설치계획을 기재한다.(계약서, 의향서 등 증빙서류 첨부) ⑤ 목표 또는 투자효과란에는 시설투자를 통한 사업추진 목표, 예상 성과 등을 기재한다. ⑥ 자금소요 산출내역에 따른 증빙서류(견적서, 시설공급 계약서, 공급의향서 등)를 첨부한다. ⑦ 협력사와 공동 사업추진 계획란에는 해당 협력사, 역할분담 등 구체적인 내용을 기재하고, 관련 증빙서류(협력사 참여의사 확인서, 협약서 등)를 첨부한다. 3. M&A자금(합병, 지분인수, 영업양수 등) 사업 계획서 ┌───────────────────────────────────────────────────────────┐ │M&A투자 사업계획서 │ │(사업명 : ) │ │Ⅰ. 기업현황 │ │ 1. 개요 │ │┏━━━━━━━━━┯━━━━━━━━━━━━━━━━━━━━━━┯━━━━━━━━━━━━━━┓ │ │┃항목 │내 용 │비고 ┃ │ │┠─────────┼──────────────────────┼──────────────┨ │ │┃현재 주생산품 │( )용 ( )부품( %), ( )용 ( )부품( %)│매출 비중이 높은 주요 ┃ │ │┃(매출비중 %) │ │생산품(용도) 기재 ┃ │ │┠─────────┼──────────────────────┴──────────────┨ │ │┃주생산품 납품단계 │□ 1차 부품(완성차사에 직접 공급) □ 2차 부품(1차업체에 공급) □ 3차 이상 ┃ │ │┠─────────┼─────────────────────────────────────┨ │ │┃M&A투자 유형 │□ 합병 □ 지분인수 □ 자산인수 □ 영업양수 □ 기타( ) ┃ │ │┠─────────┼─────────────────────────────────────┨ │ │┃투자 목적 │□ 친환경차 전용부품 생산 □ 내연기관차·친환경차 공통부품 생산 □ 기타( )┃ │ │┠─────────┼─────────────────────────────────────┨ │ │┃사업추진 방식 │□ 단독 추진 □ (공동) 협력사와 공동 추진 □ 기타( ) ┃ │ │┠─────────┼─────────────────────────────────────┨ │ │┃신청자격 유형 │□ 친환경차 부품 생산기업 □ 친환경차 부품 생산계획 기업 ┃ │ │┃ │□ 친환경차 관련 사업재편 승인기업 ┃ │ │┗━━━━━━━━━┷━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ │ │ 2. 회사연혁 │ │┏━━┯━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓ │ │┃일자│연혁(설립, 상호/대표자 변경, 법인전환, 자본증자, 사업장/공장이전 등 주요사항 기재)┃ │ │┠──┼─────────────────────────────────────────┨ │ │┃ │ ┃ │ │┗━━┷━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ │ │ │ │Ⅱ. 최근 3년간 매출 및 연구개발 투자 현황 │ │ (단위: 백만원)│ │┏━━━━━━━━━━━━━━━┯━━━┯━━━━━┯━━━━━┯━━┓ │ │┃구분 │전년도│전년도-1년│전년도-2년│평균┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃①매출액 │ │ │ │ ┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃②매출원가 │ │ │ │ ┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃③매출총이익(①-②) │ │ │ │ ┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃④영업관련 총비용 │ │ │ │ ┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃⑤영업이익(③-④) │ │ │ │ ┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃⑥자동차분야 매출액 │ │ │ │ ┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃⑦자동차분야 매출비중%(⑥/①) │ │ │ │ ┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃⑧자동차분야 연구개발 투자액 │ │ │ │ ┃ │ │┗━━━━━━━━━━━━━━━┷━━━┷━━━━━┷━━━━━┷━━┛ │ │*설립 3년 미만인 업체의 경우 설립 이후부터 작성 │ │ │ │Ⅲ. 사업계획 │ │ 1. 사 업 개 요 │ │ 2. 투 자 필 요 성 │ │ 3. 추진방안 및 일정 │ │ 4. 목 표, 투 자 효 과 │ │ 5. 투자계획(총괄표) │ │ (단위:억원) │ │┏━━━━━━━━━━━━━┯━━━━━━━━━━━━━┯━━━━━━━━━━━┓ │ │┃구분 │업체투자계획 │이차보전 연계 대출자금┃ │ │┃ │(이차보전 연계 대출 포함) │(금년 신청금액) ┃ │ │┠────┬────────┼─────────────┼───────────┨ │ │┃M&A투자 │사업 총규모(A+B)│ │- ┃ │ │┃ ├────────┼─────────────┼───────────┨ │ │┃ │기 투자액(A) │ │- ┃ │ │┃ ├────────┼─────────────┼───────────┨ │ │┃ │향후 투자계획(B)│ │ ┃ │ │┗━━━━┷━━━━━━━━┷━━━━━━━━━━━━━┷━━━━━━━━━━━┛ │ │ 6. 투자계획에 따른 자금소요 산출내역 │ │ 7. 자금 조달 계획(이차보전 연계 대출금 외 자금조달 방안) │ │ 8. 협력사와 공동 사업추진 계획(해당시) │ │ 9. 기 타 │ └───────────────────────────────────────────────────────────┘ ※작성요령 ① 지원대상 유형(친환경차 부품 생산기업 및 생산계획 기업, 친환경차 관련 사업재편 승인기업)에 따른 증빙서류(납품계약서 또는 납품확인서, 구매의향서, 사업재편 신청서 및 승인서 등)를 첨부한다. ② 자동차 분야 매출액은 생산제품 유형별 직전년도 매출액을 별첨 양식에 추가 작성한다. ③ 사업개요란에는 현재 사업현황 및 향후 친환경차 관련 사업역량 확보를 위한 M&A 등 사업계획을 기재한다. ④ 추진방안 및 일정란에는 투자자금 사용방안 및 시기를 포함한 세부계획을 기재한다.(계약서, 협약서 등 증빙서류 첨부) ⑤ 목표 또는 투자효과란에는 M&A투자를 통한 사업추진 목표, 예상 성과 등을 기재한다. ⑥ 자금소요 산출내역에 따른 증빙서류(계약서, 협약서 등)를 첨부한다. ⑦ 협력사와 공동 사업추진 계획란에는 해당 협력사, 역할분담 등 구체적인 내용을 기재하고, 관련 증빙서류(협력사 참여의사 확인서, 협약서 등)를 첨부한다.",
      "after": "[별지 제1호의1 서식] 사업계획서 1. 연구개발자금 사업 계획서 ┌───────────────────────────────────────────────────────────┐ │연구개발 사업계획서 │ │(사업명 : ) │ │Ⅰ. 기업현황 │ │ 1. 개요 │ │┏━━━━━━━━━┯━━━━━━━━━━━━━━━━━━━━━━┯━━━━━━━━━━━━━━━━━┓ │ │┃항목 │내 용 │비고 ┃ │ │┠─────────┼──────────────────────┼─────────────────┨ │ │┃현재 주생산품 │( )용 ( )부품( %), ( )용 ( )부품( %)│매출 비중이 높은 주요 ┃ │ │┃(매출비중 %) │ │생산품(용도) 기재 ┃ │ │┠─────────┼──────────────────────┴─────────────────┨ │ │┃주생산품 납품단계 │□ 1차 부품(완성차사에 직접 공급) □ 2차 부품(1차업체에 공급) □ 3차 이상 ┃ │ │┠─────────┼────────────────────────────────────────┨ │ │┃연구개발 조직 │□ 기업부설연구소 보유 □ 연구전담부서 보유 □ 기타( ) ┃ │ │┠─────────┼────────────────────────────────────────┨ │ │┃연구전담 인력 │석·박사급( 명), 학사급( 명) 등 총 ( )명 ┃ │ │┠─────────┼────────────────────────────────────────┨ │ │┃연구개발투자 목적 │□ 미래자동차 전용부품 생산 □ 내연기관차·미래자동차 공통부품 생산 □ 기타( ) ┃ │ │┠─────────┼────────────────────────────────────────┨ │ │┃신청자격 유형 │□ 미래자동차 부품 생산기업 □ 미래자동차 부품 생산계획 기업 ┃ │ │┗━━━━━━━━━┷━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ │ │ 2. 회사연혁 │ │┏━━┯━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓ │ │┃일자│연혁(설립, 상호/대표자 변경, 법인전환, 자본증자, 사업장/공장이전 등 주요사항 기재)┃ │ │┠──┼─────────────────────────────────────────┨ │ │┃ │ ┃ │ │┗━━┷━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ │ │ │ │Ⅱ. 최근 3년간 매출 및 연구개발/시설 투자 현황 │ │ (단위: 백만원)│ │┏━━━━━━━━━━━━━━━┯━━━┯━━━━━┯━━━━━┯━━┓ │ │┃구분 │전년도│전년도-1년│전년도-2년│평균┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃①매출액 │ │ │ │ ┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃②매출원가 │ │ │ │ ┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃③매출총이익(①-②) │ │ │ │ ┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃④영업관련 총비용 │ │ │ │ ┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃⑤영업이익(③-④) │ │ │ │ ┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃⑥자동차분야 매출액 │ │ │ │ ┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃⑦자동차분야 매출비중%(⑥/①) │ │ │ │ ┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃⑧자동차분야 연구개발 투자액 │ │ │ │ ┃ │ │┠───────────────┼───┼─────┼─────┼──┨ │ │┃⑨자동차분야 시설 투자액 │ │ │ │ ┃ │ │┗━━━━━━━━━━━━━━━┷━━━┷━━━━━┷━━━━━┷━━┛ │ │*설립 3년 미만인 업체의 경우 설립 이후부터 작성 │ │ │ │Ⅲ. 사업계획 │ │ 1. 사 업 개 요 │ │ 2. 개 발 필 요 성 │ │ 3. 자체 연구개발실적 및 특허 등 기술 보유 현황 │ │ 4. 개발방안 및 일정 │ │ 5. 목표, 개발효과 │ │ 6. 투자계획(총괄표) │ │ (단위:억원) │ │┏━━━━━━━━━━━━━┯━━━━━━━━━━━━━┯━━━━━━━━━━━┓ │ │┃구분 │업체투자계획 │이차보전 연계 대출자금┃ │ │┃ │(이차보전 연계 대출 포함) │(금년 신청금액) ┃ │ │┠────┬────────┼─────────────┼───────────┨ │ │┃연구개발│사업 총규모(A+B)│ │- ┃ │ │┃ ├────────┼─────────────┼───────────┨ │ │┃ │기 투자액(A) │ │- ┃ │ │┃ ├────────┼─────────────┼───────────┨ │ │┃ │향후 투자계획(B)│ │ ┃ │ │┗━━━━┷━━━━━━━━┷━━━━━━━━━━━━━┷━━━━━━━━━━━┛ │ │ 7. 투자계획에 따른 자금소요 산출내역 │ │ 8. 자금 조달 계획(이차보전 연계 대출금 외 자금조달 방안) │ │ 9. 기 타 │ └───────────────────────────────────────────────────────────┘ ※작성요령 ① 지원대상 유형(미래자동차 부품 생산기업 및 생산계획 기업)에 따른 증빙서류(납품계약서 또는 납품확인서, 구매의향서, 사업재편 신청서 및 승인서 등)를 첨부한다. ② 연구개발 전담조직과 연구개발 전담인력 보유 여부, 주요 연구개발실적, 연구개발 책임자 경력 등을 증빙할 수 있는 자료를 첨부한다. ③ 자동차 분야 매출액은 생산제품 유형별 직전년도 매출액을 별첨 양식에 추가 작성한다. ④ 사업개요란에는 현재 사업현황, 향후 미래자동차 관련 사업계획(연구개발 및 기술 확보를 통한 진출 분야/제품 포함)을 기재한다. ⑤ 개발방안 및 일정란에는 개발시작 연도 및 개발완료(예정) 연도를 포함한 연구개발 세부계획을 기재한다. ⑥ 목표 및 개발효과란에는 연구개발을 통한 사업추진 목표, 예상 성과 등을 기재한다. ⑦ 투자계획에 따른 자금소요 산출내역란에는 연구인력 인건비, 연구시설·장비비, 연구재료비 등 주요 비목별 산출금액 및 내용을 기재한다. 3천만원 이상의 장비구입은 견적서 등 증빙을 별도 첨부한다. 2. 시설자금 사업 계획서 ┌───────────────────────────────────────────────────────────┐ │시설투자 사업계획서 │ │(사업명 : ) │ │Ⅰ. 기업현황 │ │ 1. 개요 │ │┏━━━━━━━━━┯━━━━━━┯━━━━━━━━━┯━━━━━━━━━┯━━━━━━━━━━━━━┓ │ │┃항목 │계 │기존보유 │신규투자(계획) │비고 ┃ │ │┠─────────┼──────┼─────────┼─────────┼─────────────┨ │ │┃생산설비(종류) │- │( )용 ( )설비 │( )용 ( )설비 │주요 보유설비(용도), ┃ │ │┃ │ │ │ │주요 계획설비(용도) 기재 ┃ │ │┠─────────┼──────┼─────────┼─────────┼─────────────┨ │ │┃건물(연면적) │ ㎡│ ㎡ │ ㎡ │설비투자와 연계하여 ┃ │ │┃ │ │ │ │신규 확보하는 경우 ┃ │ │┠─────────┼──────┼─────────┼─────────┼─────────────┨ │ │┃부지(면적) │ ㎡│ ㎡ │ ㎡ │설비투자와 연계하여 ┃ │ │┃ │ │ │ │신규 확보하는 경우 ┃ │ │┠─────────┼──────┴─────────┴─────────┼─────────────┨ │ │┃현재 주생산품 │( )용 ( )부품( %), ( )용 ( )부품( %) │매출 비중이 높은 주요 ┃ │ │┃(매출비중 %) │ │생산품(용도) 기재 ┃ │ │┠─────────┼──────────────────────────┴─────────────┨ │ │┃주생산품 납품단계 │□ 1차 부품(완성차사에 직접 공급) □ 2차 부품(1차업체에 공급) □ 3차 이상 ┃ │ │┠─────